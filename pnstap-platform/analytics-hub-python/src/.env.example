# Cypheris backend environment
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pnstap
DB_USER=postgres
DB_PASSWORD=change-me
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local LYROMI/Ollama settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_PREDICT=256
OLLAMA_TIMEOUT_SECONDS=60

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Billing / payment provider configuration (never commit real secrets)
FRONTEND_URL=http://localhost:5173
STRIPE_SECRET_KEY=replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
